{
  "name": "foxpro-mcp",
  "version": "0.3.0",
  "description": "Servidor MCP para integrar Claude con proyectos Visual FoxPro (lectura/escritura de .prg y acceso a tablas .dbf)",
  "type": "module",
  "main": "server.js",
  "module": "server.js",
  "scripts": {
    "start": "bun server.js",
    "dev": "bun --watch server.js",
    "http": "node http_adapter.js",
    "test": "bun test",
    "build": "bun build server.js --compile --outfile foxpro-mcp.exe"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "foxpro",
    "vfp",
    "visual-foxpro",
    "dbf",
    "claude",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "iconv-lite": "^0.6.3"
  },
  "trustedDependencies": [
    "@modelcontextprotocol/sdk"
  ]
}
